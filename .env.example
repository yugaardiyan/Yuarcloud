# Yuarcloud environment overrides
# Copy to .env and adjust. All vars use the YUAR_ prefix.
#
# Dotted config keys map to underscores: auth.jwt_secret is
# YUAR_AUTH_JWT_SECRET, storage.local.root is YUAR_STORAGE_LOCAL_ROOT.
# (Until 2026-10 the underscores were collapsed with no separator, which meant
# none of these took effect — YUAR_AUTH_JWTSECRET above is the old, dead
# spelling. If you are upgrading, the correct name is YUAR_AUTH_JWT_SECRET.)

# --- Server ---
YUAR_SERVER_HOST=0.0.0.0
# Must agree with the container's healthcheck and with the port published in
# docker-compose.yml. All three are 3103; changing one without the other gives
# a container that serves traffic perfectly and reports itself unhealthy.
YUAR_SERVER_PORT=3103
YUAR_SERVER_MODE=release

# --- Auth (REQUIRED: change this) ---
# Must be at least 32 characters, or the server refuses to start.
YUAR_AUTH_JWT_SECRET=generate-with-openssl-rand-base64-48
YUAR_AUTH_TOKEN_TTL=24h
YUAR_AUTH_REFRESH_TTL=168h
YUAR_AUTH_BCRYPT_COST=12

# --- Storage ---
YUAR_STORAGE_TYPE=local
YUAR_STORAGE_LOCAL_ROOT=/srv
YUAR_STORAGE_CHUNKED_MAX_CHUNK_SIZE=10485760
YUAR_STORAGE_CHUNKED_MAX_FILE_SIZE=10737418240
# Partial uploads. Under /srv under the `.yuarcloud` prefix, which is what
# LocalStorage.List filters on — so the scratch directory never shows up in the
# browser as a folder, while a user's own .env does.
YUAR_STORAGE_CHUNKED_TEMP_DIR=/srv/.yuarcloud-chunks
YUAR_STORAGE_CHUNKED_CLEANUP_INTERVAL=1h

# --- Database ---
YUAR_DATABASE_TYPE=sqlite
YUAR_DATABASE_SQLITE_PATH=/config/yuarcloud.db

# --- Admin seed (first run only) ---
YUAR_ADMIN_DEFAULT_USER=yuarcloud
YUAR_ADMIN_DEFAULT_PASS=yuarcloud

# --- Share ---
YUAR_SHARE_DEFAULT_EXPIRY_DAYS=7
YUAR_SHARE_MAX_EXPIRY_DAYS=365
YUAR_SHARE_REQUIRE_PASSWORD=false
YUAR_SHARE_BASE_URL=

# --- Logging ---
# Logs go to stderr; `docker logs` collects them. There is no log file.
# Only the level is read. Logs go to stderr; there is no log file and no
# log volume, so docker logs / journald is where they live.
YUAR_LOGGING_LEVEL=info

# --- Rate limit ---
YUAR_RATE_LIMIT_ENABLED=true
YUAR_RATE_LIMIT_REQUESTS_PER_MINUTE=120
YUAR_RATE_LIMIT_BURST=20

# --- Docker ---
# The host-side port to publish. The container listens on YUAR_SERVER_PORT, and
# that is what this maps to. Change both together, or the healthcheck will
# probe a port nothing is listening on.
YUAR_PORT=3103
# Host-side mount points. Either leave these as named volumes, or point them at
# real directories (e.g. /mnt/nas/yuarcloud) for a bind mount.
YUAR_SRV=
YUAR_CONFIG=

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=
TZ=Asia/Jakarta